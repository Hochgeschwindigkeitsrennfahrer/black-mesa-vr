#!/bin/bash
# bm-run <outdir> [game args...]: run Black Mesa (Proton build) headless with the fake VR runtime, on an overlay.
#
# The game runs in a private user + mount namespace with an overlayfs over its folder. Everything it writes (test
# DLL, settings, saves, autosaves, config, console.log) lands in <outdir>/overlay/upper. The real folder is never
# written, so nothing needs restoring, a killed run leaks nothing, and Steam Cloud (outside the namespace) sees no
# change. live-state.sha is compared at the end as a check. The Proton prefix is a copy (BMVR_PREFIX). SteamVR is
# made unreachable, and the run is killed if a vrserver shows up.
#
# env: BMVR_PREFIX (prefix copy, required)
#      BMVR_DLL (test d3d9.dll; default the installed one)  BMVR_FLAT=1 (stock DXVK, no mod)
#      BMVR_SETTINGS=vr|flat|live (settings profile; default vr, or flat with BMVR_FLAT)
#      BMVR_XVFB_GPU=1 (real GPU into a private Xvfb, the normal way)
#      BMVR_GPU=1 (real GPU on BMVR_DISPLAY, default :0: window on the desktop, ask the user first)
#      Every mode unlocks a locked desktop first (see below).
#      BMVR_LAVAPIPE (dir with a 32-bit lavapipe ICD; crashes on map load since 2026-10-12)
#      BMVR_DISPLAY (:78)  BMVR_SCREEN  BMVR_W/BMVR_H (window, default 1920x1080 = the player's own setup)
#      BMVR_NEWUI=1 (no -oldgameui)
#      BMVR_REAL_ARGS=1 (exactly the player's launch arguments: no -w/-h/-noborder/-nosound; the size comes from videoconfig)
#      BMVR_PUT="src:game/relative/dst ..." (extra files for the run, e.g. a test cfg to +exec; never in the real folder)
#      BMVR_KEEP_UPPER=1 (keep the overlay's written files, e.g. to read a save the run made)
set -euo pipefail
out=$(realpath -m "$1"); shift
STEAM=~/.local/share/Steam
GAME="$STEAM/steamapps/common/Black Mesa"
PROTON="$STEAM/steamapps/common/Proton - Experimental"
SLR="$STEAM/steamapps/common/SteamLinuxRuntime_4"
DLLS=(d3d9.dll bin/d3d9.dll bin/thirdparty/dxvk-windows-x86/d3d9.dll)
: "${BMVR_PREFIX:?prefix copy}"
[[ -d $BMVR_PREFIX/pfx ]] || { echo "no prefix copy at $BMVR_PREFIX" >&2; exit 1; }
pgrep -x bms.exe >/dev/null && { echo "Black Mesa is already running" >&2; exit 1; }
pgrep -x vrserver >/dev/null && { echo "SteamVR is running; not testing next to it" >&2; exit 1; }
mkdir -p "$out"
W=${BMVR_W:-1920}
H=${BMVR_H:-1080}

# What the real folder must still be afterwards (the cloud copy lives outside it).
live_state() {
	(cd "$GAME" && find bms/save bms/cfg VR -maxdepth 2 -type f \( -path 'bms/save/*' -o -name '*.cfg' -o -name '*.txt' -o -name '*.json' \) \
		! -name steam_autocloud.vdf -print0 | sort -z | xargs -0 -r sha256sum
	 sha256sum bms/videoconfig.cfg "${DLLS[@]}" 2>/dev/null || true
	 stat -c '%a %n' bms/save bms/videoconfig.cfg bms/cfg/config.cfg)
	sha256sum "$STEAM"/userdata/*/362890/remote/cfg/config.cfg 2>/dev/null || true
}
live_state > "$out/live-state.sha"

upper=$out/overlay/upper
mkdir -p "$upper" "$out/overlay/work"
put() { mkdir -p "$upper/$(dirname "$2")"; cp -p "$1" "$upper/$2"; }

# Files for the run go straight into the upper layer; removals are done inside the namespace.
remove=(bms/console.log)
if [[ -n ${BMVR_FLAT:-} ]]; then
	stock=$GAME/.bmvr-backup/bin/thirdparty/dxvk-windows-x86/d3d9.dll
	[[ -f $stock ]] || { echo "stock DXVK missing: $stock" >&2; exit 1; }
	put "$stock" bin/thirdparty/dxvk-windows-x86/d3d9.dll
	remove+=(d3d9.dll bin/d3d9.dll)
	echo "FLAT: stock DXVK $(sha256sum < "$stock" | cut -c1-12), no mod, $(date +%T)" > "$out/run.log"
else
	dll=${BMVR_DLL:-$GAME/d3d9.dll}
	[[ -f $dll ]] || { echo "no mod d3d9.dll at $dll (set BMVR_DLL, or black-mesa-launch --files-vr)" >&2; exit 1; }
	for f in "${DLLS[@]}"; do put "$dll" "$f"; done
	echo "test DLL $(sha256sum < "$dll" | cut -c1-12) in overlay $(date +%T)" > "$out/run.log"
fi
profile=${BMVR_SETTINGS:-$([[ -n ${BMVR_FLAT:-} ]] && echo flat || echo vr)}
if [[ $profile != live ]]; then
	pdir=$GAME/.bmvr-settings/$profile
	[[ -f $pdir/config.cfg && -f $pdir/videoconfig.cfg ]] || { echo "no settings profile $pdir" >&2; exit 1; }
	put "$pdir/videoconfig.cfg" bms/videoconfig.cfg
	put "$pdir/config.cfg" bms/cfg/config.cfg
	# The game gets config.cfg from Steam Cloud through the Steam client, which is outside the namespace, so it would
	# run with the live mode's settings (2026-11-05: CSM on in "VR" runs). With the mod in place, have the mod's
	# bmvr_local.cfg exec the profile's values after that. A flat run sees the live cloud copy: check the live mode.
	if [[ -z ${BMVR_FLAT:-} ]]; then
		put "$pdir/config.cfg" bms/cfg/bmvr_harness_profile.cfg
		{ printf 'exec bmvr_harness_profile\r\n'; cat "$GAME/bms/cfg/bmvr_local.cfg" 2>/dev/null || true; } > "$out/overlay/local.cfg"
		put "$out/overlay/local.cfg" bms/cfg/bmvr_local.cfg
	elif [[ $profile != "$(cat "$GAME/.bmvr-settings/live" 2>/dev/null)" ]]; then
		echo "refusing: flat run with profile $profile, but the live settings (and so Steam Cloud's config) are not $profile" | tee -a "$out/run.log" >&2
		exit 1
	fi
fi
for kv in ${BMVR_PUT:-}; do put "${kv%%:*}" "${kv#*:}"; done
echo "settings profile: $profile" >> "$out/run.log"
[[ $profile == live ]] || cp -p "$pdir/config.cfg" "$out/expected-settings.cfg"

cleanup() {
	[[ -n ${game_pid:-} ]] && kill "$game_pid" 2>/dev/null || true
	local p; for p in $(pgrep -x bms.exe); do kill "$p" 2>/dev/null || true; done
	sleep 2
	for p in $(pgrep -x bms.exe); do kill -9 "$p" 2>/dev/null || true; done
	[[ -n ${xvfb_pid:-} ]] && kill "$xvfb_pid" 2>/dev/null || true
	# keep the run's console output, then drop the layer (work/ has a mode 000 dir)
	cp "$upper/bms/console.log" "$out/console.log" 2>/dev/null || true
	(cd "$upper" && find . -type f | sort) > "$out/overlay-files.txt" 2>/dev/null || true
	if [[ -z ${BMVR_KEEP_UPPER:-} ]]; then chmod -R u+rwx "$out/overlay" 2>/dev/null || true; rm -rf "${out:?}/overlay"; fi
	if cmp -s <(live_state) "$out/live-state.sha"; then
		echo "real game folder + cloud config unchanged (verified)" >> "$out/run.log"
	else
		echo "REAL GAME FOLDER CHANGED: compare $out/live-state.sha" | tee -a "$out/run.log" >&2
	fi
}
trap cleanup EXIT

# A locked or blanked desktop stalled GPU runs on :0 and spoiled window shots. Not yet tested on the private Xvfb
# since the overlay rewrite, so keep unlocking in every mode until a locked run has passed. Logged in run.log.
if command -v cinnamon-screensaver-command >/dev/null && cinnamon-screensaver-command -q 2>/dev/null | grep -q 'is active'; then
	loginctl unlock-sessions 2>/dev/null || true
	sleep 1
	cinnamon-screensaver-command -q 2>/dev/null | grep -q 'is active' && cinnamon-screensaver-command -d 2>/dev/null
	sleep 1
	DISPLAY=:0 xset dpms force on 2>/dev/null || true
	echo "desktop was locked: unlocked $(date +%T)" >> "$out/run.log"
fi
if [[ -n ${BMVR_GPU:-} ]]; then
	# real GPU on an existing X display (window appears there)
	display=${BMVR_DISPLAY:-:0}
	export DISPLAY=$display
	echo "$display" > "$out/display"
else
	display=:${BMVR_DISPLAY:-78}
	Xvfb "$display" -screen 0 ${BMVR_SCREEN:-${W}x${H}x24} -nolisten tcp >"$out/xvfb.log" 2>&1 &
	xvfb_pid=$!
	sleep 1
	export DISPLAY=$display
	echo "$display" > "$out/display"
	if [[ -n ${BMVR_XVFB_GPU:-} ]]; then
		# real GPU, presented into the private Xvfb through Mesa's CPU-copy WSI (Xvfb has no DRI3).
		export MESA_VK_WSI_DEBUG=sw
	else
		LVP=${BMVR_LAVAPIPE:?set BMVR_XVFB_GPU=1, BMVR_GPU=1 or BMVR_LAVAPIPE}
		export VK_DRIVER_FILES=$LVP/lvp_icd.json:$LVP/lvp_icd.i686.json VK_ICD_FILENAMES=$LVP/lvp_icd.json:$LVP/lvp_icd.i686.json
	fi
fi
export VR_PATHREG_OVERRIDE=/nonexistent/openvrpaths.vrpath XR_RUNTIME_JSON=/nonexistent/openxr.json
export SDL_AUDIODRIVER=dummy PULSE_SERVER=/nonexistent ALSA_CONFIG_PATH=/nonexistent
export DXVK_LOG_PATH="Z:${out//\//\\}" DXVK_STATE_CACHE=0 DXVK_LOG_LEVEL=${DXVK_LOG_LEVEL:-warn}
[[ -n ${BMVR_PROTON_LOG:-} ]] && export PROTON_LOG=1 PROTON_LOG_DIR="$out" WINEDEBUG=${WINEDEBUG:-+seh,+loaddll}
export STEAM_COMPAT_CLIENT_INSTALL_PATH=$STEAM STEAM_COMPAT_DATA_PATH=$BMVR_PREFIX STEAM_COMPAT_INSTALL_PATH=$GAME
export STEAM_COMPAT_APP_ID=362890 SteamAppId=362890 SteamGameId=362890
export WINEDLLOVERRIDES="d3d9=n,b"
export BMVR_TESTDIR="Z:${out//\//\\}"

# BMVR_NEWUI=1: Black Mesa's new (QML) game UI instead of -oldgameui
ui_arg=-oldgameui
[[ -n ${BMVR_NEWUI:-} ]] && ui_arg=

if [[ -n ${BMVR_REAL_ARGS:-} ]]; then
	launch_args=(-steam -heapsize 524288 -processheap -high -novid -windowed $ui_arg -enabledxvk)
else
	launch_args=(-steam -heapsize 524288 -processheap -novid -windowed -noborder $ui_arg -enabledxvk -nosound -w "$W" -h "$H")
fi
# Start the game WITH the profile's settings: some are read only once at startup (nr_lights_quality picks the G-buffer
# layout), and the game takes config.cfg from Steam Cloud = the live mode's settings; the later bmvr_local exec
# fixes the cvars but not what startup built (2026-11-09: VR runs had the flat G-buffer while live was flat, and the
# water holes did not reproduce). +cvar arguments run after config.cfg at startup. Caller's args come after them.
profile_args=()
if [[ -z ${BMVR_FLAT:-} && $profile != live ]]; then
	while IFS= read -r line; do
		[[ $line =~ ^([A-Za-z_][A-Za-z0-9_]*)\ \"([^\"]*)\"$ ]] || continue
		[[ -n ${BASH_REMATCH[2]} && ${BASH_REMATCH[2]} != *" "* ]] || continue
		profile_args+=("+${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")
	done < <(tr -d '\r' < "$pdir/config.cfg" | grep -v -E '^(bind|unbind)')
	echo "profile cvars on the command line: $(( ${#profile_args[@]} / 2 ))" >> "$out/run.log"
fi
# Inside the namespace (uid 0 there): mount the overlay and make the removals, then a nested namespace maps back to
# the real uid, because Wine and Steam refuse to run as root.
ns_setup='
	game=$1 upper=$2 work=$3 uid=$4 gid=$5 nrm=$6; shift 6
	mount -t overlay overlay -o "lowerdir=$game,upperdir=$upper,workdir=$work,userxattr" "$game" || exit 90
	for ((i = 0; i < nrm; i++)); do rm -f "${game:?}/${1:?}"; shift; done
	cd "$game"
	exec unshare -U --map-user="$uid" --map-group="$gid" "$@"
'
unshare -Urm --propagation private bash -c "$ns_setup" ns "$GAME" "$upper" "$out/overlay/work" "$(id -u)" "$(id -g)" "${#remove[@]}" "${remove[@]}" \
	"$SLR/_v2-entry-point" --verb=waitforexitandrun -- "$PROTON/proton" waitforexitandrun \
	"$GAME/bms.exe" "${launch_args[@]}" "${profile_args[@]}" "$@" >"$out/game.log" 2>&1 &
game_pid=$!
while kill -0 $game_pid 2>/dev/null; do
	if pgrep -x vrserver >/dev/null || pgrep -x vrmonitor >/dev/null; then
		echo "vrserver appeared during the test: stopping the game" | tee -a "$out/run.log" >&2
		break
	fi
	sleep 1
done
