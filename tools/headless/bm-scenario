#!/bin/bash
# bm-scenario <scenario file> <outdir> [game args...] — scripted headless VR test (bm-test / bm-run).
# Typical game args: +sv_cheats 1 +map bm_c1a0a   (Steam must be running.)
# Scenario lines, run in order once the mod logs its first stereo pair in a map ($BMVR_READY overrides):
# With BMVR_FLAT=1 (stock game, no mod): only wait, shot and log work; readiness comes from bms/console.log. No live
# console: put timed commands in a cfg with `wait <frames>`, then BMVR_PUT="my.cfg:bms/cfg/my.cfg" and +exec my.
#   wait <seconds>
#   cmd <console command>            appended to VR/cmd.txt (run on the engine thread within a frame or two)
#   fake <fake.txt line>              replaces the line with the same first word in VR/fake.txt
#   unfake <key>                      removes that line
#   shot <name>                       screenshot of the game window -> <outdir>/<name>.png
#   log                               copy the mod log now
#   audit [frames]                    render-target audit: per draw/copy/clear the RT written (size, viewport) and the RT
#                                     textures sampled, with the eye/frame that last wrote each (OTHER-EYE, PREV-FRAME, UNSEEN flags)
#   trace [frames]                    mod logs every render pass (RT push/pop, copies, viewports, screen rects) for N frames
#   dump <name> [step]                mod writes VR/<name>-left/right/hud.bmp: the eye pair it publishes + overlay
#                                     (every <step>th pixel, default 4)
#   projcheck [left|right|both] [deg] projection check (bm-projcheck.py): window shots before/after turning the fake
#                                     hmd about that eye (pitch, yaw, roll); fails unless each eye image uses the
#                                     projection the fake helper says the real helper would submit (1.000 +- 2 %).
# Keep scenarios short: 32-bit lavapipe has crashed ~70-90 s into a map (CS:S harness).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
scenario=$(realpath "$1")
out=$(realpath -m "$2")
shift 2
[[ -e $out ]] && { echo "$out exists; use a fresh dir" >&2; exit 1; }
mkdir -p "$out/VR"
CONSOLE=$out/overlay/upper/bms/console.log   # the game's console.log lands in the overlay; bm-run starts it empty
"$here/bm-test" "$out" -condebug "$@" >"$out/bm-test.out" 2>&1 &
runner=$!
trap 'kill $runner 2>/dev/null || true; wait $runner 2>/dev/null || true' EXIT
ready=${BMVR_READY:-$([[ -n ${BMVR_FLAT:-} ]] && echo 'LevelInitPostEntity' || echo 'Stereo HMD-fb pair done')}
is_ready() {
	if [[ -n ${BMVR_FLAT:-} ]]; then grep -q "$ready" "$CONSOLE" 2>/dev/null
	else grep -q "$ready" "$out/bmvr_log.txt" 2>/dev/null; fi
}
for i in $(seq 1 ${BMVR_LOAD_TIMEOUT:-300}); do
	is_ready && break
	kill -0 $runner 2>/dev/null || { echo "game exited before '$ready'"; exit 1; }
	sleep 1
done
is_ready || { echo "no '$ready' after ${i}s"; exit 1; }
echo "ready after ${i}s"

set_fake() {
	local key=${1%% *}
	grep -v "^$key " "$out/VR/fake.txt" > "$out/VR/fake.tmp" || true
	echo "$1" >> "$out/VR/fake.tmp"
	mv "$out/VR/fake.tmp" "$out/VR/fake.txt"
}
window_shot() {
	local display id
	display=$(cat "$out/display")
	# the game window by title and size (1920x1080 is also the monitor size); never import without an id
	id=$(DISPLAY=$display xwininfo -root -tree | awk -v g="${BMVR_W:-1920}x${BMVR_H:-1080}+" 'index($0, g) && index($0, "\"Black Mesa\"") { print $1; exit }')
	[[ -n $id ]] || { echo "no ${BMVR_W:-1920}x${BMVR_H:-1080} Black Mesa window" >&2; return 1; }
	DISPLAY=$display timeout 20 import -window "$id" "$1"
}
projcheck() {
	local eyes=${1:-both} deg=${2:-12} base e turn line n rc=0 shots
	[[ $eyes == both ]] && eyes="left right"
	base=$(grep '^hmd ' "$out/VR/fake.txt" || echo "hmd 0 0 1.70 0 0 0")
	for e in $eyes; do
		set_fake "$base"; sleep ${BMVR_SETTLE:-4}
		window_shot "$out/projcheck-$e-0.png" || return 1
		shots=("$out/projcheck-$e-0.png" "$base")
		n=0
		for turn in "$deg 0 0" "0 $deg 0" "0 0 $deg"; do
			n=$((n + 1))
			line=$(python3 -I "$here/bm-projcheck.py" pose "$base" "$e" $turn)
			set_fake "$line"; sleep ${BMVR_SETTLE:-4}
			window_shot "$out/projcheck-$e-$n.png" || return 1
			shots+=("$out/projcheck-$e-$n.png" "$line")
		done
		set_fake "$base"
		python3 -I "$here/bm-projcheck.py" fit "$e" "$out/bmvr_log.txt" "${shots[@]}" || rc=1
	done
	return $rc
}
# Guard: the game must really run with the settings profile. Ask it for the values of the cvars that change the
# picture and stop before any test if one differs (2026-11-05: a whole session of "VR" runs had flat settings).
verify_settings() {
	local exp=$out/expected-settings.cfg cv want got bad=0 reasons=
	[[ -f $exp && -z ${BMVR_FLAT:-} ]] || return 0
	for cv in cl_csm_enabled cl_csm_qualitymode cl_csm_memoryusage np_gr_quality mat_motion_blur_enabled mat_fxaa_enabled r_occlusion mat_hdr_level; do
		want=$(tr -d '\r' < "$exp" | sed -n "s/^$cv \"\(.*\)\"\$/\1/p" | head -1)
		[[ -n $want ]] || continue
		echo "$cv" >> "$out/VR/cmd.txt"
		got=
		for _ in $(seq 1 120); do   # the game may still be loading: up to 60 s
			sleep 0.5
			got=$(tr -d '\r' < "$CONSOLE" | grep -aoE "\"$cv\" = \"[^\"]*\"" | tail -1 | sed 's/.* = "//; s/"$//')   # other output can share the line
			[[ -n $got ]] && break
		done
		echo "$cv want=$want got=${got:-no answer}" >> "$out/effective-settings.txt"
		if ! [[ $got == "$want" || ( -n $got && $(python3 -Ic "print(float('$got')==float('$want'))" 2>/dev/null) == True ) ]]; then
			bad=1
			reasons+="  $cv: profile wants '$want', game has '${got:-no answer}'"$'\n'
		fi
	done
	[[ -s $out/effective-settings.txt ]] || { bad=1; reasons+="  no cvar could be checked: $exp lists none of them"$'\n'; }
	if (( bad )); then
		{
			echo "SETTINGS MISMATCH, run stopped, results would be invalid:"
			printf '%s' "$reasons"
		} | tee -a "$out/run.log" >&2
		exit 3
	fi
	echo "settings verified in the running game: $(wc -l < "$out/effective-settings.txt") cvars" | tee -a "$out/run.log"
}
verify_settings
failed=0
while IFS= read -r line || [[ -n $line ]]; do
	[[ -z $line || $line == \#* ]] && continue
	verb=${line%% *}; arg=${line#* }
	case $verb in
		wait) sleep "$arg" ;;
		cmd) if [[ -n ${BMVR_FLAT:-} ]]; then echo "cmd needs the mod (flat: +exec a cfg): $arg"; else echo "$arg" >> "$out/VR/cmd.txt"; fi ;;
		fake) set_fake "$arg" ;;
		unfake) grep -v "^$arg " "$out/VR/fake.txt" > "$out/VR/fake.tmp" || true; mv "$out/VR/fake.tmp" "$out/VR/fake.txt" ;;
		shot) if window_shot "$out/$arg.png"; then echo "shot $arg"; else echo "shot $arg FAILED"; fi ;;
		log) if [[ -n ${BMVR_FLAT:-} ]]; then cp "$CONSOLE" "$out/console-$(date +%H%M%S).txt"; else cp "$out/bmvr_log.txt" "$out/log-$(date +%H%M%S).txt"; fi ;;
		trace) echo "${arg:-2}" > "$out/VR/trace.txt"   # mod logs every RT push/pop/copy/viewport/screen rect for <arg> frames
			sleep 1 ;;
		audit) echo "${arg:-2}" > "$out/VR/audit.txt"   # render-target audit (sizes, viewports, which eye wrote each sampled RT) + trace for <arg> Presents
			sleep 1 ;;
		dump) echo "$arg" > "$out/VR/dump.txt"   # mod writes VR/<arg>-left/right/hud.bmp (published eyes + overlay)
			for _ in $(seq 1 40); do [[ -e $out/VR/dump.txt ]] || break; sleep 0.25; done
			[[ -e $out/VR/dump.txt ]] && echo "dump $arg: not picked up" || echo "dump $arg" ;;
		projcheck) [[ $arg == projcheck ]] && arg=""; projcheck $arg || failed=1 ;;
		*) echo "unknown: $line" ;;
	esac
done < "$scenario"
exit $failed
